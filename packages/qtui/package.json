{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/qtui",
  "version": "2.0.26",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Qt/C++ integration package for the headless opencode kernel (oc_core, upstream V2 line)",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "trim": "bun run src/trim.ts",
    "build": "bun run src/build.ts",
    "sync": "bun run src/sync.ts",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
