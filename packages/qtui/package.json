{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/qtui",
  "version": "2.0.32",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Qt/C++ integration package for the headless opencode kernel (oc_core, upstream V2 line)",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "trim": "bun run src/trim.ts",
    "build": "bun run src/build.ts",
    "sync": "bun run src/sync.ts",
    "smoke": "bun run src/smoke.ts",
    "contract": "bun run src/contract.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
